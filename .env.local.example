# ============================================================
# Sao chép file này thành .env.local rồi điền giá trị thật vào.
# Lệnh:  cp .env.local.example .env.local
#
# Lấy 2 giá trị dưới đây ở đâu:
#   Supabase Dashboard -> chọn project -> Settings -> API
#     - Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#     - Project API keys / anon public -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# TUYỆT ĐỐI KHÔNG commit file .env.local lên GitHub.
# Cũng không dán 2 giá trị này vào khung chat.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=thay-bang-anon-key-cua-ban
